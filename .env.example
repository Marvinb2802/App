# --- Strava ---------------------------------------------------------------
# Anlegen unter https://www.strava.com/settings/api
# "Authorization Callback Domain" muss auf "localhost" stehen (fuer lokale Entwicklung).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Anthropic (KI-Analyse, Coach-Chat, Trainingsplan) --------------------
# API-Key unter https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- App ------------------------------------------------------------------
# Basis-URL der App (fuer den OAuth-Redirect). Lokal: http://localhost:3000
APP_URL=http://localhost:3000
# Zufaelliger String zum Signieren des Session-Cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: Pfad zur SQLite-Datei (Default: ./data/app.db)
# DATABASE_PATH=./data/app.db
