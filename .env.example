# --- Datenbank (Pflicht) --------------------------------------------------
# Postgres. Kostenlos z. B. bei neon.tech oder supabase.com.
# Die Tabellen legt Pacer beim ersten Aufruf selbst an.
DATABASE_URL=postgresql://benutzer:passwort@host/datenbank?sslmode=require

# --- App (Pflicht) --------------------------------------------------------
# Basis-URL der App. Lokal: http://localhost:3000
APP_URL=http://localhost:3000
# Zufaelliger String zum Signieren des Session-Cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Strava (optional, fuer echte Aktivitaeten) ---------------------------
# Anlegen unter https://www.strava.com/settings/api
# "Authorization Callback Domain": localhost (lokal) bzw. deine Domain.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Anthropic (optional, fuer Analyse, Plan und Coach-Chat) --------------
# API-Key unter https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
